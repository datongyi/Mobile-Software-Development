<view class="page {{theme}}"><view wx:if="{{error}}" class="empty">{{error}}</view><block wx:elif="{{locked}}"><view class="empty"><image src="/assets/icons/lock-keyhole.png"/><view>寄给未来的自己</view><text>{{entry.title}}</text><text>{{entry.unlockDate}} 开启</text></view><button class="text-button danger" bindtap="remove">移入回收站</button></block><block wx:elif="{{entry}}"><view class="row entry-meta"><text class="date">{{entry.dateLabel}} · {{entry.mood}}</text><button class="icon-button favorite-button" bindtap="favorite" aria-label="收藏"><image src="{{entry.favorite?'/assets/icons/heart-filled.png':'/assets/icons/heart.png'}}"/></button></view><view class="detail-title">{{entry.displayTitle}}</view><view class="row wrap entry-tags"><text wx:for="{{entry.tags}}" wx:key="*this"># {{item}}</text></view><image wx:for="{{entry.photos}}" wx:key="*this" class="detail-photo" src="{{item}}" mode="widthFix" data-src="{{item}}" bindtap="preview"/><view class="detail-body" selectable>{{entry.body}}</view><view class="action-grid"><button class="secondary" bindtap="letter"><image class="icon" src="/assets/icons/mail.png"/>请笔友回信</button><button class="secondary" bindtap="card"><image class="icon" src="/assets/icons/share-2.png"/>制作分享卡</button></view><view class="action-grid"><button class="text-button" bindtap="edit">编辑记录</button><button class="text-button" bindtap="toggleVersions">时光切片 · {{entry.versions.length}}</button></view><view wx:if="{{versions}}"><view class="section-heading">之前写下的文字</view><view class="empty compact" wx:if="{{!entry.versions.length}}">修改文字后，旧版本会留在这里。</view><view class="list-row" wx:for="{{entry.versions}}" wx:key="at" data-index="{{index}}" bindtap="restore"><view class="bold">{{item.title || '未命名版本'}}</view><view class="excerpt">{{item.body}}</view><text class="small accent">预览并恢复 →</text></view></view><view wx:if="{{related.length}}"><view class="section-heading">记忆共鸣</view><view class="list-row" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="bold">{{item.displayTitle}}</view><text class="small muted">共同标签：{{item.common}}</text></view></view><button class="text-button danger" bindtap="remove">移入回收站</button></block></view>
