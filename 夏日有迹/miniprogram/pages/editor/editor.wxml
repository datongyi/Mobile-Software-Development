<view class="page {{theme}}"><view class="topline"><view class="page-title">{{id?'编辑这一刻':'留下一点生活'}}</view><button class="icon-button" bindtap="bookmark" aria-label="插入此刻时间"><image src="/assets/icons/clock.png"/></button></view><picker mode="date" value="{{date}}" data-key="date" bindchange="change"><view class="date-picker"><image class="icon" src="/assets/icons/calendar-days.png"/>{{date}}<text class="muted">更改日期</text></view></picker><input class="title-input" placeholder="给这一天一个名字" maxlength="80" value="{{title}}" data-key="title" bindinput="change"/><textarea class="body-input" placeholder="从一个小小的瞬间开始……" maxlength="12000" value="{{body}}" data-key="body" bindinput="change" auto-height/><view class="row between"><text class="small muted">{{body.length}} / 12000</text><text class="small muted">{{draftError?'草稿未保存':'草稿自动保留'}}</text></view><view class="error" wx:if="{{draftError}}">{{draftError}}</view><view class="photo-grid"><view class="photo-item" wx:for="{{photos}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto" aria-label="移除照片">×</button></view><button wx:if="{{photos.length<6}}" class="photo-add" bindtap="photos"><image class="icon" src="/assets/icons/camera.png"/><text>添加照片</text></button></view><view class="section-heading">此刻心情</view><view class="wrap row"><button wx:for="{{moods}}" wx:key="*this" class="chip {{mood===item?'selected':''}}" data-value="{{item}}" bindtap="mood">{{item}}</button></view><view class="section-heading">一日三刻</view><view class="period-picker"><button wx:for="{{periods}}" wx:key="id" class="period-option {{period===item.id?'selected':''}}" data-value="{{item.id}}" bindtap="period"><text class="period-mark {{item.id}}"/>{{item.name}}</button></view><text class="small muted">同一天的早晨、午后和夜晚会在时光页汇成三段色带。</text><view class="section-heading">给回忆做个标记</view><input class="field" value="{{tagText}}" placeholder="标签，以空格分开" maxlength="160" data-key="tagText" bindinput="change"/><view wx:if="{{unlockDate}}" class="capsule-settings"><view class="section-heading">时光胶囊</view><picker mode="date" value="{{unlockDate}}" data-key="unlockDate" bindchange="change" disabled="{{!!id}}"><view class="field">开启日期：{{unlockDate}}</view></picker><text class="small muted">封存后，到指定日期才可以打开。</text></view><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{unlockDate?'封存这段时光':'保存记录'}}</button><button class="text-button" bindtap="discard">放弃草稿</button></view>
