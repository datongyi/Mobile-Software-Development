<view class="page {{theme}}"><text class="eyebrow">YOUR LITTLE CORNER</text><view class="page-title">我的夏日</view><view class="profile-header"><view class="avatar large" bindtap="avatar" aria-label="选择头像"><image src="/assets/icons/{{account.avatar}}.png"/></view><view class="grow"><view class="entry-title">{{account.name}}</view><text class="muted small">本地账户 · {{total}} 篇记录</text></view><button class="text-button" bindtap="accounts">切换</button></view><view class="section-heading">让手账更像你</view><picker range="{{themes}}" value="{{themeIndex}}" bindchange="themeChange"><view class="setting-row"><text>纸面主题</text><text class="muted">{{themes[themeIndex]}} ›</text></view></picker><view class="setting-row"><text>轻量动效</text><switch checked="{{account.settings.motion}}" color="#21745D" data-key="motion" bindchange="setting"/></view><view class="setting-row"><text>轻触反馈</text><switch checked="{{account.settings.haptic}}" color="#21745D" data-key="haptic" bindchange="setting"/></view><view class="section-heading">数据与记忆</view><view class="health-panel" wx:if="{{health}}"><view class="health-grid"><view><text class="number">{{health.visible}}</text><text class="small muted">可见记录</text></view><view><text class="number">{{health.photos}}</text><text class="small muted">本地照片</text></view><view><text class="number">{{health.estimateKB}}</text><text class="small muted">约占 KB</text></view></view><view class="small muted">最长记录：{{health.largest.title}}（{{health.largest.length}} 字）</view><view class="small muted">最近备份：{{backupLabel}}</view></view><view class="setting-row" bindtap="studio"><text>夏日展览馆</text><image class="icon" src="/assets/icons/layout-grid.png"/></view><view class="setting-row" bindtap="exportData"><text>导出记录备份</text><image class="icon" src="/assets/icons/download.png"/></view><view class="setting-row" bindtap="importData"><text>从备份恢复</text><image class="icon" src="/assets/icons/upload.png"/></view><view wx:if="{{busy}}" class="notice">正在处理备份，请稍候…</view><view class="setting-row" bindtap="trash"><text>回收站</text><text class="muted">{{trash.length}} 篇 ›</text></view><view wx:if="{{trashOpen}}"><view wx:if="{{!trash.length}}" class="empty compact">回收站是空的。</view><view class="list-row" wx:for="{{trash}}" wx:key="id"><view class="bold">{{item.title||'未命名记录'}}</view><view class="row"><button class="text-button" data-id="{{item.id}}" bindtap="restore">恢复</button><button class="text-button danger" data-id="{{item.id}}" bindtap="purge">永久删除</button></view></view></view><view class="section-heading">AI 笔友</view><input class="field" value="{{proxy}}" bindinput="proxyInput" placeholder="本地代理地址"/><view class="action-grid"><button class="secondary" bindtap="saveProxy">保存地址</button><button class="secondary" bindtap="check">检查连接</button></view><view class="small muted">{{connection||'服务商、模型与密钥在电脑 server/.env 中配置'}}</view><button class="secondary" open-type="share"><image class="icon" src="/assets/icons/share-2.png"/>分享夏日有迹</button><button wx:if="{{account.demo}}" class="text-button" bindtap="resetDemo">重置演示数据</button><button class="text-button danger" bindtap="logout">退出当前账户</button><view class="footer-note">夏日有迹 · SUMMER TRACES<br/>数据保存在本机，请定期备份。</view></view>
