page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  text-align: center;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  background-color: rgba(255, 255, 255, 0.75); 
}

.content-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.title {
  color: #333333;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(255, 255, 255, 0.8);
  word-break: break-all;
}

.name-input {
  width: 75%;
  height: 80rpx;
  border: 4rpx solid #cccccc;
  border-radius: 20rpx;
  padding: 0 20rpx;
  margin-bottom: 50rpx;
  background-color: rgba(255, 255, 255, 0.9);
  text-align: center;
  font-size: 32rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.lab-image {
  width: 85%;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 60rpx;
}

.custom-btn {
  width: 65% !important;
  background-color: #07c160;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 0;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 20rpx rgba(7, 193, 96, 0.3);
  transition: all 0.2s ease;
  border: none;
  margin-bottom: 30rpx;
}

.toggle-btn {
  background-color: #1989fa;
  box-shadow: 0 10rpx 20rpx rgba(25, 137, 250, 0.3);
}

.btn-hover {
  transform: scale(0.96);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2) !important;
  opacity: 0.9;
}