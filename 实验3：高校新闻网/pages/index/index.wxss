.page { min-height: 100vh; background: #f5f7fa; color: #222; padding-bottom: 32rpx; }
.news-swiper { width: 100%; height: 400rpx; background: #ddd; }
.news-swiper image { width: 100%; height: 100%; }
.search-box { display: flex; align-items: center; margin: 22rpx 24rpx 14rpx; padding: 0 20rpx; height: 72rpx; border-radius: 36rpx; background: #fff; box-sizing: border-box; }
.search-box input { flex: 1; font-size: 28rpx; }.search-icon { margin-right: 12rpx; color: #7a8795; font-size: 38rpx; line-height: 1; }
.category-scroll { white-space: nowrap; }.category-list { display: inline-flex; padding: 0 24rpx 18rpx; }.category { margin-right: 16rpx; padding: 12rpx 22rpx; border-radius: 28rpx; background: #e9edf2; color: #56616d; font-size: 26rpx; }.category-active { background: #328eeb; color: #fff; }
.quick-actions { display: flex; margin: 0 24rpx 20rpx; padding: 20rpx 0; border-radius: 14rpx; background: #fff; }.quick-action { flex: 1; display: flex; flex-direction: column; align-items: center; color: #4d5966; font-size: 24rpx; }.quick-icon { margin-bottom: 8rpx; color: #328eeb; font-size: 40rpx; line-height: 1; }
.section-title { padding: 12rpx 24rpx 14rpx; color: #222; font-size: 34rpx; font-weight: 600; }.news-list { margin: 0 24rpx; }.news-item { display: flex; margin-bottom: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #fff; }.news-item image { width: 196rpx; height: 138rpx; flex: none; border-radius: 8rpx; }.news-info { min-width: 0; flex: 1; display: flex; flex-direction: column; justify-content: space-between; margin-left: 18rpx; }.news-title { color: #25313d; font-size: 29rpx; font-weight: 600; line-height: 1.45; }.news-summary { overflow: hidden; margin-top: 8rpx; color: #7b8794; font-size: 23rpx; white-space: nowrap; text-overflow: ellipsis; }.news-meta { display: flex; justify-content: space-between; margin-top: 10rpx; color: #94a0ad; font-size: 22rpx; }.state-message { padding: 88rpx 24rpx; color: #7a8795; text-align: center; font-size: 28rpx; }
.theme-dark { background: #17212b; color: #e8eef5; }.theme-dark .search-box, .theme-dark .quick-actions, .theme-dark .news-item { background: #24313d; }.theme-dark .search-box input, .theme-dark .section-title, .theme-dark .news-title { color: #eef4fa; }.theme-dark .category { background: #314151; color: #c8d3df; }.theme-dark .category-active { background: #328eeb; color: #fff; }.theme-dark .quick-action, .theme-dark .state-message { color: #b9c7d4; }.theme-dark .news-summary, .theme-dark .news-meta { color: #9facba; }
