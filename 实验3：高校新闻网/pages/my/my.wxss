.my-login {
  display: flex;
  height: 400rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #328eeb;
}

.avatar {
  width: 190rpx;
  height: 190rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
}

.nickname {
  margin-top: 26rpx;
  color: #ffffff;
  font-size: 34rpx;
}

.account-actions {
  display: flex;
  margin-top: 20rpx;
  gap: 18rpx;
}

.account-button {
  min-width: 156rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 52rpx;
}

.logout-button {
  border-color: #ffd0d0;
  background: #ffffff;
  color: #df4c4c;
}

.login-panel {
  display: flex;
  width: 520rpx;
  flex-direction: column;
  align-items: center;
}

.avatar-button {
  display: flex;
  box-sizing: border-box;
  width: 180rpx !important;
  min-width: 180rpx;
  max-width: 180rpx;
  height: 180rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.95);
  color: #328eeb;
  font-size: 25rpx;
  line-height: 34rpx;
}

.avatar-button image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname-input {
  box-sizing: border-box;
  width: 420rpx;
  height: 68rpx;
  margin: 20rpx 0 14rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background-color: #ffffff;
  color: #333333;
  font-size: 28rpx;
  text-align: center;
}

.login-button {
  width: 220rpx;
  border: 0;
  border-radius: 40rpx;
  background-color: #ffffff;
  color: #328eeb;
  font-size: 28rpx;
}

.stats-card { display: flex; margin: -32rpx 24rpx 18rpx; padding: 24rpx 0; border-radius: 16rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(25,68,110,.12); }.stats-card view { flex: 1; display: flex; flex-direction: column; align-items: center; }.stats-card text:first-child { color: #328eeb; font-size: 34rpx; font-weight: 600; }.stats-card text:last-child { color: #7c8793; font-size: 23rpx; }
.toolbar { display: flex; justify-content: space-between; align-items: center; margin: 0 24rpx 18rpx; padding: 18rpx 24rpx; border-radius: 14rpx; background: #fff; }.section-tabs { display: flex; margin: 0 24rpx; background: #fff; }.section-tabs view { flex: 1; padding: 24rpx 0; color: #788491; text-align: center; }.section-tabs .active { color: #328eeb; border-bottom: 4rpx solid #328eeb; }.sort-row { margin: 0 24rpx; padding: 18rpx 24rpx; background: #fff; color: #7b8794; text-align: right; }.news-list { margin: 0 24rpx; }.news-item { position: relative; padding-right: 72rpx; background: #fff; }.remove-button { position: absolute; right: 0; top: 22rpx; z-index: 2; color: #ef5350; font-size: 24rpx; }.empty-tip { margin: 0 24rpx; background: #fff; }
.theme-dark { background: #121821; color: #edf2f7; }.theme-dark .stats-card, .theme-dark .toolbar, .theme-dark .section-tabs, .theme-dark .sort-row, .theme-dark .news-list, .theme-dark .news-item, .theme-dark .empty-tip { background: #1d2633; }.theme-dark .news-title, .theme-dark .toolbar { color: #edf2f7; }.theme-dark .news-date, .theme-dark .sort-row, .theme-dark .empty-tip { color: #9eacbd; }
.my-page { min-height: 100vh; padding-bottom: 40rpx; background: #f5f7fa; }
