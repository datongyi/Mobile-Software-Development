.share-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 30rpx 180rpx;
  background: #f5f7fa;
}

.share-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 36rpx;
}

.moments-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: #22a447;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 82rpx;
  text-align: center;
}

.heading-title {
  color: #20242a;
  font-size: 36rpx;
  font-weight: 600;
}

.heading-tip {
  margin-top: 8rpx;
  color: #7d8793;
  font-size: 25rpx;
}

.share-preview {
  overflow: hidden;
  border: 1rpx solid #e3e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.poster {
  display: block;
  width: 100%;
  height: 360rpx;
}

.preview-content {
  padding: 28rpx;
}

.news-title {
  color: #20242a;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.news-summary {
  margin-top: 18rpx;
  color: #59636f;
  font-size: 28rpx;
  line-height: 42rpx;
}

.news-date {
  margin-top: 24rpx;
  color: #929aa4;
  font-size: 24rpx;
}

.share-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e8ec;
  background: #ffffff;
}

.share-actions button {
  flex: 1;
  margin: 0;
  border-radius: 8rpx;
  font-size: 29rpx;
  line-height: 78rpx;
}

.cancel-button {
  border: 1rpx solid #cfd5dc;
  background: #ffffff;
  color: #4f5965;
}

.confirm-button {
  border: 1rpx solid #22a447;
  background: #22a447;
  color: #ffffff;
}
