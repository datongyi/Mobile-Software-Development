page {
  min-height: 100vh;
  background: #f4ecdd;
}

.game-page {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 28rpx 32rpx 48rpx;
}

.game-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #dfd0ba;
  border-radius: 8rpx;
  background: #fffaf1;
}

.game-status > view {
  display: flex;
  flex-direction: column;
}

.status-center {
  align-items: center;
}

.moves-panel {
  align-items: flex-end;
}

.status-label {
  color: #9b8876;
  font-size: 22rpx;
}

.status-value {
  margin-top: 6rpx;
  color: #46362a;
  font-size: 34rpx;
  font-weight: 700;
}

.board-shell {
  position: relative;
  margin: 0 auto;
  overflow: hidden;
  border: 10rpx solid #5d5041;
  background: #d7c8aa;
  box-shadow: 0 12rpx 28rpx rgba(72, 52, 35, 0.18);
}

.pause-message {
  color: #46362a;
  font-size: 34rpx;
  font-weight: 700;
}

.game-canvas {
  width: 100%;
  height: 100%;
}

.canvas-message {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 250, 241, 0.92);
  color: #76675a;
  font-size: 26rpx;
}

.canvas-error {
  padding: 32rpx;
  color: #9d4735;
  text-align: center;
}

.control-pad {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
}

.control-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.control-row-top {
  margin-bottom: 12rpx;
}

.direction {
  display: flex;
  width: 108rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #284c3b;
  border-radius: 8rpx;
  background: #3f7458;
  color: #fffaf1;
  font-size: 44rpx;
  line-height: 1;
}

.tool-button::after {
  border: 0;
}

.direction-disabled {
  background: #a99d8d;
  color: #eee8df;
}

.tool-row {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.tool-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #fffaf1;
  color: #3f7458;
  font-size: 25rpx;
}

.pause-button {
  background: #3f7458;
  color: #fffaf1;
}

.restart-button {
  border-radius: 8rpx;
  background: #b5683d;
  color: #fffaf1;
}

.game-tip {
  display: block;
  margin-top: 20rpx;
  color: #8d7b69;
  font-size: 23rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .game-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .direction {
    width: 96rpx;
  }
}
