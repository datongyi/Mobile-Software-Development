/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}

button { border-radius: 12rpx; }


page {
  background: #F2F4F8;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.page-title { color: #161616; font-size: 44rpx; font-weight: 600; }
